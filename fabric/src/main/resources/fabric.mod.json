{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "NetherDon",
    "Oculifelis"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/netheragriculture",
    "sources": "https://github.com/Oculifelis/NetherAgriculture"
  },
  "license": "${license}",
  "icon": "assets/netheragriculture/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ru.netherdon.netheragriculture.fabric.NetherAgricultureFabric"
    ],
    "client": [
      "ru.netherdon.netheragriculture.fabric.client.NetherAgricultureFabricClient"
    ],
    "jei_mod_plugin": [
      "ru.netherdon.netheragriculture.compat.jei.NAJeiPlugin"
    ],
    "modmenu": [
      "ru.netherdon.netheragriculture.fabric.compat.modmenu.NAModMenuPlugin"
    ]
  },
  "mixins": [
    "netheragriculture.mixins.json",
    "netheragriculture.fabric.mixins.json"
  ],
  "accessWidener": "netheragriculture.fabric.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "forgeconfigapiport": "*"
  }
}
